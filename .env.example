DATABASE_URL=postgresql://compliance_user:replace_me@127.0.0.1:5432/compliance_vault
AUTH_SECRET=replace-with-at-least-32-random-characters
DEFAULT_TENANT_ID=replace-with-tenant-id
OIDC_ISSUER=https://identity.example/replace-me
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me-if-confidential-client
OIDC_REDIRECT_URI=https://compliance.example/api/auth/oidc/callback
OIDC_ROLE_CLAIM=groups
OIDC_TENANT_CLAIM=tenant_id
OIDC_ROLE_MAP_JSON={"compliance-admin":"admin","compliance-manager":"manager","compliance-analyst":"analyst"}
# Local password identities are provisioned explicitly with `npm --prefix frontend run create-admin`.
